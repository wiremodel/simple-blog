created:
    - database/factories/PostFactory.php
    - database/factories/CategoryFactory.php
    - database/factories/CommentFactory.php
    - database/migrations/2025_08_25_130852_create_posts_table.php
    - database/migrations/2025_08_25_130853_create_categories_table.php
    - database/migrations/2025_08_25_130854_create_comments_table.php
    - database/migrations/2025_08_25_130855_create_category_post_table.php
    - app/Models/Post.php
    - app/Models/Category.php
    - app/Models/Comment.php
models:
    User: { name: string, email: string, email_verified_at: 'datetime nullable', password: string, remember_token: 'string nullable' }
    Post: { title: string, slug: string, excerpt: 'text:255 nullable', content: 'longtext nullable', thumbnail: 'string nullable', featured_image: 'string nullable', gallery: 'json nullable', tags: 'json nullable', status: "enum('draft', 'published', 'archived') default:'draft'", published_at: 'datetime nullable', relationships: { belongsToMany: Category, belongsTo: User, hasMany: Comment } }
    Category: { name: string, slug: string, content: 'longtext nullable', image: 'string nullable', published: 'boolean default:false', published_at: 'datetime nullable', relationships: { belongsToMany: Post } }
    Comment: { title: string, content: 'longtext nullable', published: 'boolean default:false', published_at: datetime, relationships: { belongsTo: 'Post, User' } }
